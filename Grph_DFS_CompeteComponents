// complete subgraph if edgesCount==nodes*(nodes-1)/2 so we need to fins the nodes and edges using dfs->1 connected component
class Solution {
    List<List<Integer>> adj;
    int nodes,degSum;
    boolean[] visited;
    public int countCompleteComponents(int n, int[][] edges) {
        adj=new ArrayList<>();
        for(int i=0;i<n;i++){
            adj.add(new ArrayList<>());
        }
        for(int[] e:edges){
            adj.get(e[0]).add(e[1]);
            adj.get(e[1]).add(e[0]);
        }
        int complete=0;
        visited=new boolean[n];
        for(int i=0;i<n;i++){
            if(!visited[i]){
                nodes=0;
                degSum=0;
                dfs(i);
                int ed=degSum/2;
                if(ed==nodes*(nodes-1)/2) complete++;
            }
        }
        return complete;
    }
    void dfs(int n){
        visited[n]=true;
        nodes++;
        degSum+=adj.get(n).size();
        for(int nei:adj.get(n)){
            if(!visited[nei])
               dfs(nei);
        }
    }
}
