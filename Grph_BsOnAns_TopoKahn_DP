//https://leetcode.com/problems/network-recovery-pathways/?envType=daily-question&envId=2026-07-03

class Solution {
    public int findMaxPathScore(int[][] edges, boolean[] online, long k) {
        int n=online.length;
        List<List<int[]>> adj=new ArrayList<>();
        for(int i=0;i<n;i++){
            adj.add(new ArrayList<>());
        }
        int maxWt=Integer.MIN_VALUE;
        int[] indegree=new int[n];
        for(int[] e:edges){
            int u=e[0];
            int v=e[1];
            int w=e[2];
            adj.get(u).add(new int[]{v,w});
            indegree[v]++;
            maxWt=Math.max(maxWt,w);
        }
        int high=maxWt;
        int low=0; //cost min is 0->constraint in the Q
        int ans=-1;
        while(low<=high){
            int mid=low+(high-low)/2;
            if(check(mid,adj,indegree,online,k)){
                ans=mid;
                low=mid+1;
            }
            else{
                high=mid-1;
            }
        }
        return ans;
    }
    private boolean check(int limit,List<List<int[]>> adj, int[] indegree, boolean[] online, long k){
        Queue<Integer> q=new LinkedList<>();
        int n=online.length;
        int[] temp=indegree.clone();
        for(int i=0;i<n;i++){
            if(temp[i]==0) q.offer(i);
        }
        long[] dp=new long[n];
        Arrays.fill(dp,Long.MAX_VALUE);
        dp[0]=0;
        while(!q.isEmpty()){
            int u=q.poll();
            if(u!=0 && u!=n-1 && !online[u]){
                for(int[] node:adj.get(u)){
                    temp[node[0]]--;
                    if(temp[node[0]]==0) q.offer(node[0]);
                }
                continue;
            }
            for(int[] node:adj.get(u)){
                    int v=node[0];
                    int w=node[1];
                    if(w>=limit && dp[u]!=Long.MAX_VALUE){
                        dp[v]=Math.min(dp[v],dp[u]+w);
                    }
                    temp[v]--;
                    if(temp[v]==0) q.offer(v);
                }
        }
        return dp[n-1]<=k;
    }
}
